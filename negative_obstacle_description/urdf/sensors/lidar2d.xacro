<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    2D gpu_lidar sensor (single vertical sample, 360 deg horizontal). This is
    the reference sensor the 3D pipeline is compared against: it cannot see
    negative obstacles, which is the motivation for the detector.
  -->
  <xacro:macro name="lidar2d" params="name parent_link xyz rpy">
    <link name="${name}_link">
      <visual>
        <geometry><cylinder radius="0.06" length="0.05"/></geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <geometry><cylinder radius="0.06" length="0.05"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="2e-4" ixy="0" ixz="0" iyy="2e-4" iyz="0" izz="3e-4"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <gazebo reference="${name}_link">
      <sensor type="gpu_lidar" name="${name}">
        <topic>${name}</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.05</min>
            <max>12</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
        <always_on>1</always_on>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>
