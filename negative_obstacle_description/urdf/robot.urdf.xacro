<?xml version="1.0"?>
<robot name="negative_obstacle_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Reference AMR for the negative-obstacle detector.

    Frame tree (REP-105 / REP-103):
      base_footprint            ground plane, z = 0
      +  base_link             chassis centre, z = +0.15 m
         +  left_wheel_link    differential drive
         +  right_wheel_link
         +  caster_front_link
         +  caster_back_link
         +  sensor_mast        vertical mast, x = +0.20 m
         +  imu_link

    Sensor mount heights are frozen in docs/detection-spec.md (Section 5):
      RGB-D camera: 0.45 m above ground, pitch -13.5 deg
      3D lidar:     0.60 m above ground, pitch -5 deg
      2D lidar:     0.30 m above ground

    Sensor links are attached with explicit world positions in the sensor
    xacro files under urdf/sensors/.
  -->

  <material name="dark_grey"><color rgba="0.20 0.20 0.22 1"/></material>
  <material name="orange"><color rgba="0.95 0.45 0.10 1"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>

  <!-- Geometry (SI units). -->
  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="track" value="0.44"/>
  <xacro:property name="caster_offset" value="0.20"/>
  <xacro:property name="chassis_length" value="0.50"/>
  <xacro:property name="chassis_width" value="0.60"/>
  <xacro:property name="chassis_height" value="0.30"/>
  <xacro:property name="chassis_z" value="0.15"/>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="12.0"/>
      <!-- Box 0.50 x 0.60 x 0.30, m = 12 kg. -->
      <inertia ixx="0.45" ixy="0" ixz="0" iyy="0.34" iyz="0" izz="0.61"/>
    </inertial>
  </link>

  <!-- Differential drive wheels. -->
  <xacro:macro name="drive_wheel" params="prefix reflect_y">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 ${reflect_y * track / 2} ${wheel_radius - chassis_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="20" velocity="5"/>
    </joint>

    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <mass value="0.4"/>
        <inertia ixx="0.00069" ixy="0" ixz="0" iyy="0.00128" iyz="0" izz="0.00069"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:drive_wheel prefix="left" reflect_y="-1"/>
  <xacro:drive_wheel prefix="right" reflect_y="1"/>

  <!-- Passive casters for stability. -->
  <xacro:macro name="caster" params="prefix reflect_x">
    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_caster_link"/>
      <origin xyz="${reflect_x * caster_offset} 0 ${0.04 - chassis_z}" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}_caster_link">
      <visual>
        <geometry><sphere radius="0.04"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><sphere radius="0.04"/></geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.000064" ixy="0" ixz="0" iyy="0.000064" iyz="0" izz="0.000064"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:caster prefix="front" reflect_x="1"/>
  <xacro:caster prefix="back" reflect_x="-1"/>

  <!-- Vertical mast carrying the sensors. -->
  <link name="sensor_mast">
    <visual>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <geometry><box size="0.08 0.08 0.35"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <geometry><box size="0.08 0.08 0.35"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0052" ixy="0" ixz="0" iyy="0.0052" iyz="0" izz="0.00053"/>
    </inertial>
  </link>

  <joint name="sensor_mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_mast"/>
    <origin xyz="0.20 0 0.15" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!--
    Sensors. Mount heights (relative to ground, i.e. base_footprint z = 0):
      depth_camera: 0.45 m, tilted 13.5 deg downward
      lidar3d:      0.60 m, tilted 5 deg downward
      lidar2d:      0.30 m, level

    Sign convention: URDF/Gazebo use the right-hand rule, so a positive pitch
    about +y tips the +x (forward) axis toward -z (down). A downward tilt of
    N degrees is therefore written as a positive rpy pitch of N deg.
  -->
  <xacro:include filename="$(find negative_obstacle_description)/urdf/sensors/depth_camera.xacro"/>
  <xacro:include filename="$(find negative_obstacle_description)/urdf/sensors/lidar3d.xacro"/>
  <xacro:include filename="$(find negative_obstacle_description)/urdf/sensors/lidar2d.xacro"/>

  <xacro:depth_camera name="depth_camera" parent_link="base_link"
    xyz="0.25 0 0.30" rpy="0 0.23562 0"/>
  <xacro:lidar3d name="lidar3d" parent_link="base_link"
    xyz="0.20 0 0.45" rpy="0 0.08727 0"/>
  <xacro:lidar2d name="lidar2d" parent_link="base_link"
    xyz="0 0 0.15" rpy="0 0 0"/>

  <!--
    Differential-drive plugin. Publishes /cmd_vel (subscription) and odometry
    inside Gazebo; the bridge maps them to ROS in the simulation package.
  -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${track}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </gazebo>

</robot>
