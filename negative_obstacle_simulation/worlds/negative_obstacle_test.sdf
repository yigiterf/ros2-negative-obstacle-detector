<?xml version="1.0" ?>
<!--
  Factory test world for the negative-obstacle detector.

  Run:  gz sim -r negative_obstacle_test.sdf
  Ground truth for every dimension: docs/detection-spec.md

  Layout (top view, +x right, +y up):
    - main aisle along x, y in [-2, 2]
    - N1 narrow pit at (2.5, 0), N2 shallow pit at (-4.0, 4.5)
    - N3 dock edge at x = 7.5, N4 ramp at x in [5.8, 7.5]
    - O1 workbench, O2 conveyor, O3 low pipe
    - storage racks at y = +/-6
-->
<sdf version="1.11">
  <world name="factory_negative_obstacle">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.38 0.40 0.43 1</ambient>
      <background>0.70 0.79 0.88 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="daylight">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>1.00 0.98 0.92 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.35 0.25 -0.90</direction>
    </light>

    <light type="point" name="high_bay_west">
      <cast_shadows>false</cast_shadows>
      <pose>-6 4 5.2 0 0 0</pose>
      <diffuse>0.85 0.87 0.90 1</diffuse>
      <specular>0.10 0.10 0.10 1</specular>
      <attenuation>
        <range>22</range>
        <constant>0.60</constant>
        <linear>0.02</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <light type="point" name="high_bay_east">
      <cast_shadows>false</cast_shadows>
      <pose>6 -3 5.2 0 0 0</pose>
      <diffuse>0.85 0.87 0.90 1</diffuse>
      <specular>0.10 0.10 0.10 1</specular>
      <attenuation>
        <range>22</range>
        <constant>0.60</constant>
        <linear>0.02</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!--
      Floor: seven coplanar slabs leave two rectangular openings. The slabs are
      0.30 m thick so their vertical faces form the pit walls down to the pit
      bottoms. Top surface is z = 0.
    -->
    <model name="factory_floor">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="floor_link">

        <collision name="band_south_collision">
          <pose>0 -4.65 -0.15 0 0 0</pose>
          <geometry><box><size>24 8.7 0.3</size></box></geometry>
        </collision>
        <visual name="band_south_visual">
          <pose>0 -4.65 -0.15 0 0 0</pose>
          <geometry><box><size>24 8.7 0.3</size></box></geometry>
          <material>
            <ambient>0.42 0.43 0.45 1</ambient>
            <diffuse>0.55 0.56 0.58 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
            <pbr><metal>
              <roughness>0.92</roughness>
              <metalness>0.0</metalness>
            </metal></pbr>
          </material>
        </visual>

        <collision name="band_n1_west_collision">
          <pose>-4.90 0 -0.15 0 0 0</pose>
