<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>negative_obstacle_costmap_plugin</name>
  <version>0.1.0</version>
  <description>
    Nav2 costmap layer that subscribes to the negative-obstacle hazard point
    cloud and marks the corresponding cells as lethal.
  </description>

  <maintainer email="beteljesed@gmail.com">fyigiter</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>nav2_costmap_2d</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_sensor_msgs</depend>
  <depend>pluginlib</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_costmap_2d plugin="${prefix}/plugins.xml"/>
  </export>
</package>
